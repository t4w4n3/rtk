{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "1"
  },
  "model": "opusplan",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-analysis.sh",
            "timeout": 120,
            "statusMessage": "Running static analysis..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
