{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-analysis.sh",
            "timeout": 120,
            "statusMessage": "Running static analysis..."
          }
        ]
      }
    ]
  }
}
